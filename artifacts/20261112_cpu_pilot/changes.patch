+            ids=p+c+tail;labels=[-100]*len(p)+c+[-100]*len(tail)
+            target=np.asarray(ids[1:]);active=np.asarray(labels[1:])!=-100
+            logp=-.01*(1+target%17)-1e-6*np.arange(len(ids)-1)
