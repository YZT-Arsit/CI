+                        assert int(((ids[i]==eos)&(labels[i]!=-100)).sum())==1
+                        got_sum=float(lp[i,active[i]].sum());got_mean=float(lp[i,active[i]].mean())
+                        error=max(abs(got_sum-expected_sum),abs(got_mean-expected_mean));max_error=max(max_error,error)
+                        assert error<1e-12
